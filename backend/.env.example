ENV=dev
# When running via `docker compose up`, docker-compose.yml overrides this to point at the
# `db` service on the internal network. This value is used when running the API directly
# on the host (outside Docker) against the Postgres container's published port.
DATABASE_URL=postgresql+asyncpg://staynaija:staynaija@localhost:5433/staynaija
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace-me
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-replace-me
PLATFORM_COMMISSION_PERCENT=3.5
CORS_ORIGINS=*
UPLOAD_DIR=uploads
# Must match whatever the mobile clients' ApiConfig.baseUrl points at - override
# this to your LAN IP if testing on a physical device without `adb reverse`.
PUBLIC_BASE_URL=http://localhost:8000

# Optional. Leave all three blank for local dev - uploads then write to disk
# under UPLOAD_DIR instead (see app/services/storage.py). Fill in for
# production, where container disk doesn't survive a redeploy.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
# Blank uses storage.bunnycdn.com; a region code (e.g. "ny") targets a
# region-pinned storage zone instead - see https://docs.bunny.net/docs/storage-regions.
BUNNY_STORAGE_REGION=
# The Pull Zone hostname (or mapped custom domain), e.g. staynaija.b-cdn.net -
# never the storage endpoint itself, which only accepts writes.
BUNNY_STORAGE_PULL_ZONE_HOST=
