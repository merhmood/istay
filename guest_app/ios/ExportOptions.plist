<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "development" installs straight to registered test devices (what you
	     want for testing on your own iPhone). Switch to "ad-hoc" only if you
	     need to distribute outside Bitrise's own install link. -->
	<key>method</key>
	<string>development</string>

	<!-- Find this at developer.apple.com under Membership Details. -->
	<key>teamID</key>
	<string>REPLACE_WITH_YOUR_APPLE_TEAM_ID</string>

	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<!-- The exact name of the provisioning profile you create in
		     developer.apple.com for this bundle id - not the file name. -->
		<key>com.staynaija.staynaija</key>
		<string>REPLACE_WITH_YOUR_PROVISIONING_PROFILE_NAME</string>
	</dict>

	<key>compileBitcode</key>
	<false/>
</dict>
</plist>
